      "id": "nocard",
      "name": "No card",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        880,
        224
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={\n  \"row_id\": \"rm-{{ $('Normalise request').first().json.run_date }}-{{ $('Normalise request').first().json.item_id || 'tmdb-' + $('Normalise request').first().json.tmdb_id }}\",\n  \"platform\": \"instagram\",\n  \"status\": \"ready_to_post\",\n  \"caption\": {{ JSON.stringify($('Normalise request').first().json.caption) }},\n  \"card_url\": {{ JSON.stringify($json.image_url) }},\n  \"scheduled_date\": \"{{ $('Normalise request').first().json.scheduled_date }}\",\n  \"tmdb_id_a\": \"{{ $('Normalise request').first().json.tmdb_id }}\",\n  \"title_a\": {{ JSON.stringify($json.title || '') }},\n  \"tmdb_id_b\": \"\",\n  \"title_b\": \"\",\n  \"warnings\": \"from ReelMatch Marketing Office (guardian-approved, human-approved)\",\n  \"last_error\": \"\",\n  \"processed_at\": \"\"\n}",
        "options": {}
      },
      "id": "row",
      "name": "Queue row",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
