        "jsonOutput": "={\n  \"ok\": true,\n  \"row_id\": \"{{ $('Queue row').first().json.row_id }}\",\n  \"card_url\": {{ JSON.stringify($('Queue row').first().json.card_url) }},\n  \"scheduled_date\": \"{{ $('Queue row').first().json.scheduled_date }}\",\n  \"message\": \"queued \u2014 RM: Publish ready posts to Instagram will post it on its next Mon/Wed/Sat 08:00 run\"\n}",
        "options": {}
