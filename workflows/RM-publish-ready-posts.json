    {
      "parameters": {
        "jsCode": "// Published. Record it so the row is never picked up again.\nreturn $input.all().map((item, i) => {\n  let src;\n  try { src = $('Limit to one post').itemMatching(i).json; }\n  catch (e) { src = $('Limit to one post').all()[i]?.json ?? {}; }\n  return { json: {\n    row_id: src.row_id ?? '',\n    status: 'posted',\n    last_error: '',\n    processed_at: new Date().toISOString(),\n  } };\n});\n"
      },
      "id": "cc7b031e-e922-4c80-a4c0-55416ead78f2",
      "name": "Mark posted1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        336,
        656
      ]
    },
    {
      "parameters": {
        "jsCode": "// Publishing failed - mark the row rather than losing it.\nreturn $input.all().map((item, i) => {\n  const j = item.json ?? {};\n  let src;\n  try { src = $('Limit to one post').itemMatching(i).json; }\n  catch (e) { src = $('Limit to one post').all()[i]?.json ?? {}; }\n  const msg = typeof j.error === 'string' ? j.error : (j.error?.message ?? JSON.stringify(j).slice(0, 300));\n  return { json: {\n    row_id: src.row_id ?? '',\n    status: 'needs_review',\n    last_error: `instagram publish failed: ${msg}`.slice(0, 500),\n    processed_at: new Date().toISOString(),\n  } };\n});\n"
      },
      "id": "d14e7d6a-94bf-4ce1-8532-cf7e2e244b8f",
      "name": "Mark failed1",
      "type": "n8n-nodes-base.code",
