    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# n8n's Python task runner exposes `_items` (this node runs once for all items), NOT the JS\n# helpers: there is no `$('Other Node')`, and the sandbox sets N8N_RUNNERS_STDLIB_ALLOW=\"\" so even\n# `import re` fails with \"Security violations detected\". Both nodes below are therefore written\n# with plain built-ins and read only their own input. See n8n/README.md.\n\n# The gateway answers 200 (published / queued / replied), 403 (no approval or guardian reject),\n# 503 (publishing disabled) or 400. Turn each into one line the human understands.\n# Only result_line is read downstream \u2014 the Telegram nodes pull the rest from \"Split taps\".\n\nr = _items[0][\"json\"]\nbody = r.get(\"body\", r)\nif not isinstance(body, dict):\n    body = {}\ncode = r.get(\"statusCode\", 200)\nupload = body.get(\"youtube_upload\") or {}\n\nif code == 200 and body.get(\"manual\"):\n    line = \"\\u2705 Approved \u2014 \" + str(body.get(\"message\", \"\"))\nelif code == 200 and body.get(\"queued\"):\n    line = (\"\\u2705 Queued for Instagram (\" + str(body.get(\"scheduled_date\", \"\"))\n            + \") \u2014 your Mon/Wed/Sat publisher posts it\")\nelif code == 200 and body.get(\"replied\"):\n    line = \"\\u2705 Reply posted: \" + str(body.get(\"url\", \"\"))\nelif code == 200:\n    when = upload.get(\"scheduledAt\")\n    line = \"\\u2705 \" + (\"Scheduled to go public \" + str(when) if when else \"Uploaded PRIVATE\")\n    if upload.get(\"url\"):\n        line += \" \\u00b7 \" + str(upload[\"url\"])\nelif code == 503:\n    line = (\"\\u2705 Approved \u2014 publishing is disabled on this host \"\n            \"(STUDIO_ALLOW_PUBLISH=false), so nothing was sent to YouTube.\")\nelse:\n    detail = str(body.get(\"detail\") or body)\n    line = \"\\u26a0\\ufe0f Approved but publish failed (\" + str(code) + \"): \" + detail[:200]\n\nreturn [{\"json\": {\"result_line\": line}}]\n"
      },
