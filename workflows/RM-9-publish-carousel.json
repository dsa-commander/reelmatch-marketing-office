        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/17841478416834267/media",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "image_url",
              "value": "={{ $json.url }}"
            },
            {
              "name": "is_carousel_item",
              "value": "true"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "child",
      "name": "IG: child container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "Q7bgoLbLuLzMpOJf",
          "name": "Instagram Facebook Token"
        }
      }
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# Collapse the per-slide containers back into one item: the parent needs them as a single\n# comma-separated list, in the order the slides were given.\nids = [i['json'].get('id') for i in _items if i['json'].get('id')]\nif len(ids) != len(_items):\n    raise ValueError('only %d of %d slide containers came back with an id' % (len(ids), len(_items)))\nreturn [{'json': {'children': ','.join(ids), 'count': len(ids)}}]"
      },
